<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_bg" android:scaleType="fitXY"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ImageView android:id="@+id/cover" android:layout_width="72dp" android:layout_height="72dp" android:scaleType="centerCrop"/>
            <ImageView android:id="@+id/logo" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="end|top" android:src="@drawable/w_logo"/>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginRight="6dp">
                <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF"/>
            <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textColor="#C8FFFFFF"/>
            </LinearLayout>
            <FrameLayout android:id="@+id/play" android:layout_width="40dp" android:layout_height="40dp">
            <ImageView android:id="@+id/play_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_circle"/>
            <ImageView android:id="@+id/play_icon" android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:src="@drawable/w_pause"/>
        </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
